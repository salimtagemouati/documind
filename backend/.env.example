# ============================================================
# DocuMind Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ============================================================

# ─── App ─────────────────────────────────────────────────────
APP_NAME=DocuMind
ENVIRONMENT=development        # development | staging | production
DEBUG=true

# ─── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Supabase ────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Connection string: Project Settings → Database → Connection string (URI mode)
# Replace [YOUR-PASSWORD] with the DB password
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── Storage ─────────────────────────────────────────────────
SUPABASE_BUCKET=documents
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=["pdf","txt","docx","md"]

# ─── AI / LLM — Google Gemini (free tier, $0 cost) ───────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ─── RAG ─────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CHUNKS_PER_DOC=200
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.70

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW=60

# ─── Redis ───────────────────────────────────────────────────
# Local: redis://localhost:6379
# Upstash (free): rediss://default:password@host:port
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ─── Quotas (no billing) ─────────────────────────────────────
# Maximum documents per account. Set to 0 to disable the cap.
FREE_DOC_LIMIT=10

# ─── Monitoring ──────────────────────────────────────────────
# Optional: https://sentry.io/
SENTRY_DSN=
