# DocuMind backend configuration. Copy to .env; never commit .env.

APP_NAME=DocuMind
ENVIRONMENT=development
DEBUG=false

SECRET_KEY=replace-with-a-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:5173

SUPABASE_URL=https://your-project.example.invalid
SUPABASE_ANON_KEY=replace-with-anonymous-key
SUPABASE_SERVICE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
SUPABASE_BUCKET=documents
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,txt,docx,md

LLM_PROVIDER=gemini
GOOGLE_API_KEY=replace-with-provider-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://localhost:11434
LLM_MODEL=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768
LLM_MAX_CONCURRENCY=3

CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CHUNKS_PER_DOC=200
RAG_TOP_K=6
RAG_INITIAL_TOP_K=15
RAG_SIMILARITY_THRESHOLD=0.50
ENABLE_RERANKING=true
ENABLE_HYBRID_SEARCH=true

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW=60

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_FREE_DOC_LIMIT=3
STRIPE_FREE_QUERY_LIMIT=20
FRONTEND_URL=http://localhost:5173

SENTRY_DSN=
