# ============================================================
# DocuMind Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ============================================================

# ─── App ─────────────────────────────────────────────────────
APP_NAME=DocuMind
ENVIRONMENT=development        # development | staging | production
DEBUG=true

# ─── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Supabase ────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Connection string: Project Settings → Database → Connection string (URI mode)
# Replace [YOUR-PASSWORD] with the DB password
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── Storage ─────────────────────────────────────────────────
SUPABASE_BUCKET=documents
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=["pdf","txt","docx","md"]

# ─── AI / LLM — Multi-Provider via LiteLLM ($0 Free Tier) ──
# Google Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
# Or OPENAI_API_KEY / GROQ_API_KEY / ANTHROPIC_API_KEY / OLLAMA_API_BASE
LLM_MODEL=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768
LLM_MAX_CONCURRENCY=3

# ─── RAG & Vector Search (pgvector HNSW + Two-Stage Rerank) ─
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CHUNKS_PER_DOC=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES=10

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW=60

# ─── Redis ───────────────────────────────────────────────────
# Local: redis://localhost:6379
# Upstash (free): rediss://default:password@host:port
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ─── Stripe (Billing) ───────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a recurring price in Stripe Dashboard → Products
STRIPE_PRICE_ID_PRO=price_...
STRIPE_FREE_DOC_LIMIT=3
STRIPE_FREE_QUERY_LIMIT=20
FRONTEND_URL=http://localhost:5173

# ─── Monitoring ──────────────────────────────────────────────
# Optional: https://sentry.io/
SENTRY_DSN=
