# Copy to backend/.env.production (ignored). Never paste secrets into chat.
SECRET_KEY=REPLACE_ME_WITH_A_NEW_RANDOM_PRODUCTION_SECRET_AT_LEAST_32_CHARACTERS
ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@YOUR_PROJECT_POOLER:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_KEY=REPLACE_ME
SUPABASE_BUCKET=documents
STORAGE_BACKEND=supabase
REDIS_URL=rediss://REPLACE_ME@YOUR_REDIS_HOST:6379/0
GOOGLE_API_KEY=REPLACE_ME
LLM_MODEL=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768
ENABLE_RERANKING=false
ENABLE_HYBRID_SEARCH=true
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=120
ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
ANALYSIS_MODE=combined
